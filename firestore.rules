/**
 * FIRESTORE SECURITY RULES
 * Updated: 2024-03-21 14:30:00 (Mandatory Redeployment for Public Catalog)
 * 
 * Core Philosophy:
 * This application serves as a public product catalog. 
 * All visitors (authenticated or not) must have read access to products and categories.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- PUBLIC ACCESS RULES ---

    /**
     * @description Allow public read access to all product categories.
     * Required for the sidebar and category navigation.
     */
    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Allow public read access to all products.
     * This covers both individual 'get' and collection 'list' operations.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // --- DEFAULT FALLBACK ---
    // Explicitly deny any other access to ensure security.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

  }
}