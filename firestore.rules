/**
 * Heovose 全球智能制造管理系统 - 安全规则 v1.6
 *
 * 优化点：
 * 1. 确保 isAdmin() 检查在处理大负载文档时尽可能高效。
 * 2. 统一驼峰命名路径。
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 核心辅助函数 ---

    function isSignedIn() {
      return request.auth != null;
    }

    // 检查当前用户是否在管理员白名单中
    // 提示：确保 Firestore 中的文档 ID 是用户的 UID (bFjZ3BVfU8...)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function getRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      let adminDoc = get(/databases/$(database)/documents/admins/$(request.auth.uid));
      return isSignedIn() && adminDoc != null && adminDoc.data.role == 'superadmin';
    }

    // --- 业务集合规则 ---

    match /products/{docId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /productCategories/{docId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /galleryAssets/{docId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /galleryCategories/{docId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /homepageContent/{docId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /specTemplates/{docId} { 
      allow read: if isAdmin(); 
      allow write: if isAdmin(); 
    }

    match /localizedStrings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'languages' || isAdmin();
      allow write: if isAdmin();
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if isSuperAdmin();
    }
  }
}