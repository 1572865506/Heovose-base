/**
 * FIRESTORE SECURITY RULES
 * Forced Redeployment Timestamp: 2024-05-20 16:30:00
 * 
 * Purpose: Public Product Catalog
 * Access: Global Read / No Write
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow anyone to read product categories
    match /product_categories/{category} {
      allow read: if true;
      allow write: if false;
    }

    // Allow anyone to read products
    match /products/{product} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}