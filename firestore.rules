
/**
 * FIRESTORE SECURITY RULES
 * Forced Redeployment Timestamp: 2025-02-21 17:30:00
 * 
 * Status: Read-Only Public Access for Product Catalog
 * This file is managed by the App Prototyper.
 * 
 * Note: Changing this comment triggers a re-deployment to the Firebase console.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 允许公开读取产品分类
    match /product_categories/{category} {
      allow read: if true;
      allow write: if false;
    }

    // 允许公开读取产品详情
    match /products/{product} {
      allow read: if true;
      allow write: if false;
    }

    // 默认禁止其他所有写入
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
