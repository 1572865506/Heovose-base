rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 允许任何用户（包括未登录用户）读取所有集合
    // 这是一个极简的只读规则，用于确保原型开发阶段的数据顺畅访问
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
