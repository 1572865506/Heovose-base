
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 部署时间戳: 2024-06-05 18:00:00
    
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /admins/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /specTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    match /localizedStrings/{localizedStringId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /galleryAssets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/languages {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/ai {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
