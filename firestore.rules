/**
 * FIRESTORE SECURITY RULES
 * Updated: 2024-03-20 (Forced re-deployment)
 * 
 * Core Philosophy:
 * This ruleset implements a Public Catalog model.
 * - Public Read Access: All users (including anonymous/unauthenticated) can read categories and products.
 * - Restricted Writes: No client-side writes are permitted.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- COLLECTION RULES ---

    /**
     * @description Rules for Product Categories. Publicly readable.
     */
    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Rules for individual Products. Publicly readable.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

  }
}