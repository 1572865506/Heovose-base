/**
 * FIRESTORE SECURITY RULES
 * Updated: 2024-05-20 14:45:00 (Forced Redeployment for Public Catalog)
 * 
 * Core Philosophy:
 * This application serves as a public product catalog. 
 * All visitors must have read access to products and categories to view the catalog.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- PUBLIC ACCESS RULES ---

    /**
     * @description Allow public read access to all product categories.
     * This is essential for the sidebar navigation and filtering.
     */
    match /product_categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    /**
     * @description Allow public read access to all products.
     * This covers both individual 'get' and collection 'list' operations.
     */
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // --- DEFAULT FALLBACK ---
    // Explicitly deny any other access to ensure system security.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

  }
}
