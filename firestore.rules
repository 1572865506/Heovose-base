/**
 * Heovose 全球智能制造管理系统 - 安全规则 v1.4
 *
 * 核心逻辑：
 * 1. 命名规范：严格遵循前端驼峰命名 (CamelCase)，修复 productCategories 访问受阻问题。
 * 2. 身份验证：基于 /admins 集合中的 UID 文档进行鉴权。
 * 3. 角色管理：
 *    - superadmin: 拥有全站最高权限，包括管理其他管理员。
 *    - editor: 拥有业务内容（产品、图库、翻译、流程）的读写权。
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 核心辅助函数 ---

    // 检查是否已登录
    function isSignedIn() {
      return request.auth != null;
    }

    // 检查当前用户是否在管理员白名单中
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 获取当前用户的角色
    function getRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    // 检查是否为超级管理员
    function isSuperAdmin() {
      return isAdmin() && getRole() == 'superadmin';
    }

    // --- 业务集合规则 ---

    // 产品、分类、图库、统计、生产流程等业务数据
    // 逻辑：公众只读，管理员可写
    match /products/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /productCategories/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /galleryAssets/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /galleryCategories/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /coreStatistics/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /productionSteps/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /factoryLocations/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /homepageContent/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /specTemplates/{docId} { allow read: if isAdmin(); allow write: if isAdmin(); }

    // 多语言翻译库
    match /localizedStrings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 系统设置（AI、语种等）
    match /settings/{settingId} {
      allow read: if settingId == 'languages' || isAdmin();
      allow write: if isAdmin();
    }

    // 管理员权限表
    match /admins/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if isSuperAdmin();
    }
  }
}