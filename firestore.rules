/**
 * Heovose Elevate: Firestore Security Rules
 * Updated: 2024-05-24 10:00:00 (Forced Redeploy)
 *
 * Core Philosophy:
 * This ruleset implements a "Public Read, Administrative Write" model. 
 *
 * Key Security Decisions:
 * 1. Admin Verification: Users can 'get' their own document in /admins/{uid} to verify privileges.
 * 2. Public Read Access: All content collections allow 'get' and 'list' operations for all users.
 * 3. Locked Writes: Administrative writes are restricted at the rules level for now.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Stores authenticated administrators.
     * @path /admins/{uid}
     * @allow get: if request.auth != null && request.auth.uid == uid;
     */
    match /admins/{uid} {
      // 允许用户读取自己的管理员状态进行身份验证
      allow get: if request.auth != null && request.auth.uid == uid;
      // 禁止列表或写入，管理员名单管理通常在控制台进行
      allow list, write: if false;
    }

    /**
     * @description Localized text strings for English and Chinese translations.
     * @path /localizedStrings/{localizedStringId}
     */
    match /localizedStrings/{localizedStringId} {
      allow get, list: if true;
      allow create, update, delete: if false; 
    }

    /**
     * @description Configuration and content for dynamic homepage sections.
     */
    match /homepageSectionContent/{sectionId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Categories for products (e.g., AIO, Mini PC).
     */
    match /productCategories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Individual product details.
     */
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Company performance and scale statistics.
     */
    match /statistics/{statisticId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Steps detailing the manufacturing process.
     */
    match /productionSteps/{stepId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Geographical locations for global factories.
     */
    match /factoryLocations/{locationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}