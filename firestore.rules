
/**
 * FIRESTORE SECURITY RULES
 * Forced Redeployment Timestamp: 2025-02-21 10:15:00
 * 
 * Status: Read-Only Public Access for Product Catalog
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 允许任何用户（包括未登录用户）读取产品分类
    match /product_categories/{category} {
      allow read: if true;
      allow write: if false;
    }

    // 允许任何用户（包括未登录用户）读取产品列表
    // 明确允许 get 和 list 操作
    match /products/{product} {
      allow read: if true;
      allow write: if false;
    }

    // 默认禁止其他所有集合的访问
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
