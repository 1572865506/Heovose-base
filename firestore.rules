/**
 * Heovose 全球智能制造管理系统 - 安全规则 v1.3
 *
 * 核心逻辑：
 * 1. 公共访问：全站产品、分类、统计、流程等内容对游客开放只读。
 * 2. 身份验证：只有在 /admins 集合中存在对应 UID 文档的用户才被视为管理员。
 * 3. 角色管理：
 *    - superadmin: 拥有全站最高权限，包括管理其他管理员。
 *    - editor: 拥有业务内容（产品、图库、翻译、流程）的读写权。
 * 4. 自愈诊断：允许用户读取自己的 admin 文档以进行权限自检。
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 核心辅助函数 ---

    // 检查是否已登录
    function isSignedIn() {
      return request.auth != null;
    }

    // 检查当前用户是否在管理员白名单中
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 获取当前用户的角色
    function getRole() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role;
    }

    // 检查是否为超级管理员
    function isSuperAdmin() {
      return isAdmin() && getRole() == 'superadmin';
    }

    // --- 业务集合规则 ---

    // 产品、分类、图库、统计、生产流程等业务数据
    // 逻辑：公众只读，管理员可写
    match /products/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /product_categories/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /galleryAssets/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /galleryCategories/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /core_statistics/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /production_process_steps/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /factory_locations/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /homepage_content/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /specTemplates/{docId} { allow read: if isAdmin(); allow write: if isAdmin(); }

    // 多语言翻译库
    // 逻辑：官网需要读取翻译，管理员需要管理
    match /localizedStrings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 系统设置（AI、语种等）
    match /settings/{settingId} {
      // 语种配置对公众开放（用于前台切换），AI配置仅限管理员
      allow read: if settingId == 'languages' || isAdmin();
      allow write: if isAdmin();
    }

    // 管理员权限表
    match /admins/{userId} {
      // 关键：允许用户读取自己的文档用于“权限自检”和“个人中心”展示
      allow get: if isSignedIn() && request.auth.uid == userId;
      // 只有超级管理员可以列出所有成员或新增/修改授权
      allow list, create, update, delete: if isSuperAdmin();
    }
  }
}