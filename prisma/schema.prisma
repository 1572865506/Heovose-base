generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LocalizedString {
  id            String            @id @default(cuid())
  content       Json              @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  productDescs  Product[]         @relation("ProductDesc")
  productNames  Product[]         @relation("ProductName")
  categoryDescs ProductCategory[] @relation("CategoryDesc")
  categoryNames ProductCategory[] @relation("CategoryName")
}

model HomepageContent {
  id                         String        @id @default("hero")
  heroHeadlineEn             String?
  heroHeadlineZh             String?
  heroSubheadlineEn          String?
  heroSubheadlineZh          String?
  heroWholesaleButtonEn      String?
  heroWholesaleButtonZh      String?
  heroProjectButtonEn        String?
  heroProjectButtonZh        String?
  heroWholesaleCategoryId    String?
  heroProjectCategoryId      String?
  isVideoEnabled             Boolean       @default(true)
  videoTitleEn               String?
  videoTitleZh               String?
  videoSubtitleEn            String?
  videoSubtitleZh            String?
  mapTitleEn                 String?
  mapTitleZh                 String?
  mapSubtitleEn              String?
  mapSubtitleZh              String?
  heroProjectDescriptionEn   String?
  heroProjectDescriptionZh   String?
  heroSlides                 Json?
  heroWholesaleDescriptionEn String?
  heroWholesaleDescriptionZh String?
  videoUrl                   String?
  heroProjectBg              String?
  heroWholesaleBg            String?
  bentoSubtitleEn            String?
  bentoSubtitleZh            String?
  bentoTitleEn               String?
  bentoTitleZh               String?
  processSubtitleEn          String?
  processSubtitleZh          String?
  processTitleEn             String?
  processTitleZh             String?
  gallerySubtitleEn          String?
  gallerySubtitleZh          String?
  galleryTitleEn             String?
  galleryTitleZh             String?
  galleryItems               Json?
  casesSubtitleEn            String?
  casesSubtitleZh            String?
  casesTitleEn               String?
  casesTitleZh               String?
  casesSubtitleTextId        String?       @default("CASES_SUBTITLE")
  casesTitleTextId           String?       @default("CASES_TITLE")
  processSubtitleTextId      String?       @default("PROCESS_SUBTITLE")
  processTitleTextId         String?       @default("PROCESS_TITLE")
  mapSubtitleTextId          String?       @default("MAP_SUBTITLE")
  mapTitleTextId             String?       @default("MAP_TITLE")
  locations                  MapLocation[]
}

model HomepageBentoItem {
  id         String   @id @default(cuid())
  order      Int      @default(0)
  titleZh    String
  titleEn    String
  tagZh      String?
  tagEn      String?
  imageUrl   String
  linkUrl    String?
  gridSize   String   @default("small")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  brightness Float?
  linkType   String   @default("custom")
  categoryId String?
}

model MapLocation {
  id              String          @id @default(cuid())
  type            String
  titleZh         String
  titleEn         String
  addressZh       String
  addressEn       String
  descZh          String
  descEn          String
  imageUrl        String?
  posTop          String
  posLeft         String
  homepageId      String
  addressTextId   String?
  descTextId      String?
  titleTextId     String?
  order           Int             @default(0)
  countryCode     String?         @default("cn")
  homepageContent HomepageContent @relation(fields: [homepageId], references: [id])
}

model CaseStudy {
  id                String  @id @default(cuid())
  order             Int     @default(0)
  tagZh             String
  tagEn             String
  titleZh           String
  titleEn           String
  descZh            String
  descEn            String
  imageUrl          String
  brightness        Float?
  descriptionTextId String?
  tagTextId         String?
  titleTextId       String?
  published         Boolean @default(true)
}

model ProductionStep {
  id                String   @id @default(cuid())
  order             Int      @default(0)
  titleZh           String
  titleEn           String
  descZh            String
  descEn            String
  imageUrls         String[]
  brightnesses      Float[]
  descriptionTextId String?
  titleTextId       String?
}

model Product {
  id                       String           @id @default(cuid())
  status                   String           @default("draft")
  nameTextId               String
  categoryId               String?
  advantageTextIds         String[]
  createdAt                DateTime         @default(now())
  descriptionTextId        String?
  enabledLanguages         String[]
  galleryImageUrls         String[]
  localizedDetails         Json?
  mainImageUrl             String?
  videoUrl                 String?
  specGroups               Json?
  updatedAt                DateTime         @updatedAt
  galleryImageBrightnesses Float[]
  mainImageBrightness      Float?
  category                 ProductCategory? @relation(fields: [categoryId], references: [id])
  descriptionText          LocalizedString? @relation("ProductDesc", fields: [descriptionTextId], references: [id], onDelete: Cascade)
  nameText                 LocalizedString  @relation("ProductName", fields: [nameTextId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([nameTextId])
  @@index([descriptionTextId])
}

model ProductCategory {
  id                  String            @id @default(cuid())
  slug                String            @unique
  thumbnailImageUrl   String?
  parentId            String?
  nameTextId          String
  descriptionTextId   String?
  order               Int               @default(0)
  thumbnailBrightness Float?
  products            Product[]
  descriptionText     LocalizedString?  @relation("CategoryDesc", fields: [descriptionTextId], references: [id], onDelete: Cascade)
  nameText            LocalizedString   @relation("CategoryName", fields: [nameTextId], references: [id], onDelete: Cascade)
  parent              ProductCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children            ProductCategory[] @relation("CategoryToCategory")

  @@index([parentId])
  @@index([nameTextId])
  @@index([descriptionTextId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("editor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  permissions   Json?     @default("[]")
  lastSeen      DateTime?
  accounts      Account[]
  sessions      Session[]
}

model Inquiry {
  id            String    @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  subject       String?
  message       String
  productId     String?
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailViewedAt DateTime?
}

model VisitorSession {
  id        String           @id @default(cuid())
  visitorId String
  ip        String?
  country   String?
  city      String?
  userAgent String?
  referrer  String?
  createdAt DateTime         @default(now())
  lastPath  String?
  updatedAt DateTime         @default(now()) @updatedAt
  events    AnalyticsEvent[]

  @@index([visitorId])
}

model AnalyticsEvent {
  id        String         @id @default(cuid())
  sessionId String
  type      String
  path      String
  x         Float?
  y         Float?
  element   String?
  timestamp DateTime       @default(now())
  extraData Json?
  session   VisitorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model GalleryCategory {
  id       String            @id @default(cuid())
  name     String
  order    Int               @default(0)
  parentId String?
  assets   GalleryAsset[]
  parent   GalleryCategory?  @relation("GalleryToGallery", fields: [parentId], references: [id])
  children GalleryCategory[] @relation("GalleryToGallery")
}

model GalleryAsset {
  id           String           @id @default(cuid())
  title        String
  url          String
  categoryId   String?
  createdAt    DateTime         @default(now())
  fileName     String
  fileSize     Int?
  height       Int?
  width        Int?
  duration     Float?
  thumbnailUrl String?
  type         String           @default("IMAGE")
  brightness   Float?
  category     GalleryCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Setting {
  id    String @id
  value String
}

model SpecTemplate {
  id         String   @id @default(cuid())
  name       String
  specGroups Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
