generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LocalizedString {
  id                String            @id @default(cuid())
  zh                String
  en                String
  productDescs      Product[]         @relation("ProductDesc")
  productNames      Product[]         @relation("ProductName")
  categoryNames     ProductCategory[] @relation("CategoryName")
  categoryDescs     ProductCategory[] @relation("CategoryDesc")
}

model HomepageContent {
  id                         String        @id @default("hero")
  heroHeadlineEn             String?
  heroHeadlineZh             String?
  heroSubheadlineEn          String?
  heroSubheadlineZh          String?
  heroWholesaleButtonEn      String?
  heroWholesaleButtonZh      String?
  heroProjectButtonEn        String?
  heroProjectButtonZh        String?
  heroWholesaleCategoryId    String?
  heroProjectCategoryId      String?
  isVideoEnabled             Boolean       @default(true)
  videoTitleEn               String?
  videoTitleZh               String?
  videoSubtitleEn            String?
  videoSubtitleZh            String?
  mapTitleEn                 String?
  mapTitleZh                 String?
  mapSubtitleEn              String?
  mapSubtitleZh              String?
  heroProjectDescriptionEn   String?
  heroProjectDescriptionZh   String?
  heroSlides                 Json?
  heroWholesaleDescriptionEn String?
  heroWholesaleDescriptionZh String?
  videoUrl                   String?
  locations                  MapLocation[]
}

model MapLocation {
  id              String          @id @default(cuid())
  type            String
  titleZh         String
  titleEn         String
  addressZh       String
  addressEn       String
  descZh          String
  descEn          String
  imageUrl        String?
  posTop          String
  posLeft         String
  homepageId      String
  homepageContent HomepageContent @relation(fields: [homepageId], references: [id])
}

model CaseStudy {
  id       String @id @default(cuid())
  order    Int    @default(0)
  tagZh    String
  tagEn    String
  titleZh  String
  titleEn  String
  descZh   String
  descEn   String
  imageUrl String
}

model ProductionStep {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  titleZh   String
  titleEn   String
  descZh    String
  descEn    String
  imageUrls String[]
}

model Product {
  id                String           @id @default(cuid())
  status            String           @default("draft")
  nameTextId        String
  categoryId        String?
  advantageTextIds  String[]
  createdAt         DateTime         @default(now())
  descriptionTextId String?
  enabledLanguages  String[]
  galleryImageUrls  String[]
  localizedDetails  Json?
  mainImageUrl      String?
  specGroups        Json?
  updatedAt         DateTime         @updatedAt
  category          ProductCategory? @relation(fields: [categoryId], references: [id])
  descriptionText   LocalizedString? @relation("ProductDesc", fields: [descriptionTextId], references: [id], onDelete: Cascade)
  nameText          LocalizedString  @relation("ProductName", fields: [nameTextId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([nameTextId])
  @@index([descriptionTextId])
}

model ProductCategory {
  id                String            @id @default(cuid())
  slug              String            @unique
  thumbnailImageUrl String?
  parentId          String?
  nameTextId        String
  descriptionTextId String?
  order             Int               @default(0)
  products          Product[]
  nameText          LocalizedString   @relation("CategoryName", fields: [nameTextId], references: [id], onDelete: Cascade)
  descriptionText   LocalizedString?  @relation("CategoryDesc", fields: [descriptionTextId], references: [id], onDelete: Cascade)
  parent            ProductCategory?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children          ProductCategory[] @relation("CategoryToCategory")

  @@index([parentId])
  @@index([nameTextId])
  @@index([descriptionTextId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("editor")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model GalleryCategory {
  id       String            @id @default(cuid())
  name     String
  order    Int               @default(0)
  parentId String?
  assets   GalleryAsset[]
  parent   GalleryCategory?  @relation("GalleryToGallery", fields: [parentId], references: [id])
  children GalleryCategory[] @relation("GalleryToGallery")
}

model GalleryAsset {
  id         String           @id @default(cuid())
  title      String
  url        String
  categoryId String?
  createdAt  DateTime         @default(now())
  fileName   String
  fileSize   Int?
  category   GalleryCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
}

model Setting {
  id    String @id
  value String
}

model SpecTemplate {
  id         String   @id @default(cuid())
  name       String
  specGroups Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
