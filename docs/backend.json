
{
  "entities": {
    "HomepageContent": {
      "title": "HomepageContent",
      "type": "object",
      "description": "首页核心配置数据（单例文档）",
      "properties": {
        "id": { "type": "string" },
        "heroHeadlineEn": { "type": "string" },
        "heroHeadlineZh": { "type": "string" },
        "heroSubheadlineEn": { "type": "string" },
        "heroSubheadlineZh": { "type": "string" },
        "heroWholesaleButtonEn": { "type": "string" },
        "heroWholesaleButtonZh": { "type": "string" },
        "heroProjectButtonEn": { "type": "string" },
        "heroProjectButtonZh": { "type": "string" },
        "heroWholesaleCategoryId": { "type": "string", "description": "批发按钮跳转的分类ID" },
        "heroProjectCategoryId": { "type": "string", "description": "项目按钮跳转的分类ID" },
        "videoTitleEn": { "type": "string" },
        "videoTitleZh": { "type": "string" },
        "videoSubtitleEn": { "type": "string" },
        "videoSubtitleZh": { "type": "string" },
        "mapTitleEn": { "type": "string" },
        "mapTitleZh": { "type": "string" },
        "mapSubtitleEn": { "type": "string" },
        "mapSubtitleZh": { "type": "string" },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["HQ", "R&D", "Factory", "Global"] },
              "titleZh": { "type": "string" },
              "titleEn": { "type": "string" },
              "addressZh": { "type": "string" },
              "addressEn": { "type": "string" },
              "descZh": { "type": "string" },
              "descEn": { "type": "string" },
              "imageUrl": { "type": "string" },
              "posTop": { "type": "string", "description": "地图垂直位置百分比, 如 40%" },
              "posLeft": { "type": "string", "description": "地图水平位置百分比, 如 75%" }
            }
          }
        }
      }
    },
    "CaseStudy": {
      "title": "CaseStudy",
      "type": "object",
      "description": "全球成功案例展示",
      "properties": {
        "id": { "type": "string" },
        "order": { "type": "number" },
        "tagZh": { "type": "string", "description": "行业标签，如：智慧零售" },
        "tagEn": { "type": "string", "description": "Tag, e.g. RETAIL" },
        "titleZh": { "type": "string" },
        "titleEn": { "type": "string" },
        "descZh": { "type": "string" },
        "descEn": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["id", "titleZh", "imageUrl"]
    },
    "ProductionStep": {
      "title": "ProductionStep",
      "type": "object",
      "description": "生产流程步骤配置",
      "properties": {
        "id": { "type": "string" },
        "order": { "type": "number", "description": "步骤排序权重" },
        "titleZh": { "type": "string" },
        "titleEn": { "type": "string" },
        "descZh": { "type": "string" },
        "descEn": { "type": "string" },
        "imageUrls": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "步骤关联的图片地址列表"
        }
      },
      "required": ["id", "order", "titleZh"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "硬件产品核心实体",
      "properties": {
        "id": { "type": "string" },
        "nameTextId": { "type": "string", "description": "指向 localizedStrings 的 ID" },
        "status": { "type": "string", "enum": ["published", "draft"] }
      }
    },
    "ProductCategory": {
      "title": "ProductCategory",
      "type": "object",
      "description": "产品分类 definition",
      "properties": {
        "id": { "type": "string" },
        "nameTextId": { "type": "string" },
        "slug": { "type": "string" },
        "thumbnailImageUrl": { "type": "string" }
      }
    },
    "AdminUser": {
      "title": "AdminUser",
      "type": "object",
      "description": "系统管理员角色定义",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Authentication 唯一标识符" },
        "email": { "type": "string", "description": "管理员邮箱" },
        "role": { "type": "string", "enum": ["superadmin", "editor"], "description": "权限角色" },
        "displayName": { "type": "string", "description": "显示名称" },
        "avatarUrl": { "type": "string", "description": "头像链接（Base64 或 URL）" },
        "status": { "type": "string", "enum": ["active", "disabled"], "description": "账号激活状态" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "LocalizedString": {
      "title": "LocalizedString",
      "type": "object",
      "description": "多语言翻译词条",
      "properties": {
        "id": { "type": "string" },
        "zh": { "type": "string" },
        "en": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/backend/entities/Product" },
      "description": "产品列表"
    },
    "/caseStudies/{caseId}": {
      "schema": { "$ref": "#/backend/entities/CaseStudy" },
      "description": "全球客户成功案例"
    },
    "/productCategories/{categoryId}": {
      "schema": { "$ref": "#/backend/entities/ProductCategory" },
      "description": "产品业务分类"
    },
    "/productionSteps/{stepId}": {
      "schema": { "$ref": "#/backend/entities/ProductionStep" },
      "description": "制造流程步骤"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/backend/entities/AdminUser" },
      "description": "管理员权限白名单"
    },
    "/localizedStrings/{textId}": {
      "schema": { "$ref": "#/backend/entities/LocalizedString" },
      "description": "多语言翻译资产库"
    },
    "/homepageContent/{contentId}": {
        "schema": { "$ref": "#/backend/entities/HomepageContent" },
        "description": "首页内容配置"
    },
    "/settings/ai": {
      "schema": { "type": "object" },
      "description": "AI 智译引擎配置"
    },
    "/settings/languages": {
      "schema": { "type": "object" },
      "description": "全站支持语种及默认语种配置"
    },
    "/galleryAssets/{assetId}": {
      "schema": { "type": "object" },
      "description": "云端媒体资产库"
    },
    "/specTemplates/{templateId}": {
      "schema": { "type": "object" },
      "description": "硬件技术规格复用模板"
    }
  }
}
