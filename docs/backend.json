
{
  "entities": {
    "AdminUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminUser",
      "type": "object",
      "description": "Represents a user with administrative privileges.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "editor"] }
      },
      "required": ["uid", "email"]
    },
    "GalleryCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GalleryCategory",
      "type": "object",
      "description": "Custom categories for organizing gallery assets.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "GalleryAsset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GalleryAsset",
      "type": "object",
      "description": "Represents a media asset in the global gallery.",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "categoryId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["id", "url", "title", "categoryId"]
    },
    "LocalizedString": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LocalizedString",
      "type": "object",
      "description": "Multilingual text content.",
      "properties": {
        "id": { "type": "string" },
        "en": { "type": "string" },
        "zh": { "type": "string" }
      },
      "required": ["id", "en", "zh"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/admins/{uid}",
        "definition": {
          "entityName": "AdminUser",
          "schema": { "$ref": "#/backend/entities/AdminUser" },
          "description": "Authorized administrators."
        }
      },
      {
        "path": "/galleryCategories/{categoryId}",
        "definition": {
          "entityName": "GalleryCategory",
          "schema": { "$ref": "#/backend/entities/GalleryCategory" },
          "description": "Flexible categories for gallery."
        }
      },
      {
        "path": "/galleryAssets/{assetId}",
        "definition": {
          "entityName": "GalleryAsset",
          "schema": { "$ref": "#/backend/entities/GalleryAsset" },
          "description": "Central media gallery assets."
        }
      },
      {
        "path": "/localizedStrings/{localizedStringId}",
        "definition": {
          "entityName": "LocalizedString",
          "schema": { "$ref": "#/backend/entities/LocalizedString" },
          "description": "Multilingual text content."
        }
      }
    ]
  }
}
