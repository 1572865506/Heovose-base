
{
  "entities": {
    "AdminUser": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AdminUser",
      "type": "object",
      "description": "Represents a user with administrative privileges.",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "editor"] }
      },
      "required": ["uid", "email"]
    },
    "ProductCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductCategory",
      "type": "object",
      "description": "Hardware product categories with multi-language support.",
      "properties": {
        "id": { "type": "string" },
        "nameTextId": { "type": "string", "description": "Reference to LocalizedString" },
        "slug": { "type": "string" },
        "thumbnailImageUrl": { "type": "string" },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "nameTextId", "slug"]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Hardware product details including complex technical specs and multi-language content.",
      "properties": {
        "id": { "type": "string" },
        "nameTextId": { "type": "string" },
        "descriptionTextId": { "type": "string" },
        "detailsTextId": { "type": "string" },
        "advantageTextIds": { "type": "array", "items": { "type": "string" } },
        "specGroups": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "titleId": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "labelId": { "type": "string" },
                    "valueId": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "mainImageUrl": { "type": "string" },
        "productCategoryId": { "type": "string" },
        "galleryImageUrls": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "updatedAt": { "type": "object" }
      },
      "required": ["id", "nameTextId", "productCategoryId", "mainImageUrl"]
    },
    "GalleryCategory": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GalleryCategory",
      "type": "object",
      "description": "Custom categories for organizing gallery assets with hierarchy support.",
      "properties": {
        "id": { "type": "string" },
        "nameTextId": { "type": "string", "description": "Reference to LocalizedString for multi-language names." },
        "parentId": { "type": "string", "description": "ID of the parent category for nested structure." },
        "order": { "type": "number" }
      },
      "required": ["id", "nameTextId"]
    },
    "GalleryAsset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "GalleryAsset",
      "type": "object",
      "description": "Represents a media asset in the global gallery.",
      "properties": {
        "id": { "type": "string" },
        "url": { "type": "string" },
        "title": { "type": "string" },
        "categoryId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["id", "url", "title", "categoryId"]
    },
    "LocalizedString": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "LocalizedString",
      "type": "object",
      "description": "Multilingual text content with dynamic keys.",
      "properties": {
        "id": { "type": "string" },
        "en": { "type": "string" },
        "zh": { "type": "string" }
      },
      "required": ["id", "en", "zh"]
    },
    "AppConfig": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AppConfig",
      "type": "object",
      "description": "Global application settings.",
      "properties": {
        "supportedLanguages": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "label": { "type": "string" }
            }
          } 
        }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/admins/{uid}",
        "definition": {
          "entityName": "AdminUser",
          "schema": { "$ref": "#/backend/entities/AdminUser" },
          "description": "Authorized administrators."
        }
      },
      {
        "path": "/productCategories/{categoryId}",
        "definition": {
          "entityName": "ProductCategory",
          "schema": { "$ref": "#/backend/entities/ProductCategory" },
          "description": "Product classification."
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Hardware product records."
        }
      },
      {
        "path": "/galleryCategories/{categoryId}",
        "definition": {
          "entityName": "GalleryCategory",
          "schema": { "$ref": "#/backend/entities/GalleryCategory" },
          "description": "Flexible hierarchical categories for gallery."
        }
      },
      {
        "path": "/galleryAssets/{assetId}",
        "definition": {
          "entityName": "GalleryAsset",
          "schema": { "$ref": "#/backend/entities/GalleryAsset" },
          "description": "Central media gallery assets."
        }
      },
      {
        "path": "/localizedStrings/{localizedStringId}",
        "definition": {
          "entityName": "LocalizedString",
          "schema": { "$ref": "#/backend/entities/LocalizedString" },
          "description": "Multilingual text content."
        }
      },
      {
        "path": "/settings/languages",
        "definition": {
          "entityName": "AppConfig",
          "schema": { "$ref": "#/backend/entities/AppConfig" },
          "description": "Multilingual support configuration."
        }
      }
    ]
  }
}
