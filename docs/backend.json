{
  "entities": {
    "HomepageContent": {
      "title": "HomepageContent",
      "type": "object",
      "description": "首页核心配置数据",
      "properties": {
        "id": { "type": "string" },
        "heroHeadlineEn": { "type": "string" },
        "heroHeadlineZh": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "硬件产品核心实体",
      "properties": {
        "id": { "type": "string" },
        "nameTextId": { "type": "string", "description": "指向 localizedStrings 的 ID" },
        "status": { "type": "string", "enum": ["published", "draft"] }
      }
    },
    "AdminUser": {
      "title": "AdminUser",
      "type": "object",
      "description": "系统管理员角色定义",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["superadmin", "editor"] },
        "displayName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "disabled"] }
      }
    },
    "LocalizedString": {
      "title": "LocalizedString",
      "type": "object",
      "description": "多语言翻译词条",
      "properties": {
        "id": { "type": "string" },
        "zh": { "type": "string" },
        "en": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/products/{productId}",
        "definition": { "entityName": "Product", "schema": { "$ref": "#/backend/entities/Product" }, "description": "产品列表" }
      },
      {
        "path": "/admins/{userId}",
        "definition": { "entityName": "AdminUser", "schema": { "$ref": "#/backend/entities/AdminUser" }, "description": "管理员白名单" }
      },
      {
        "path": "/localizedStrings/{textId}",
        "definition": { "entityName": "LocalizedString", "schema": { "$ref": "#/backend/entities/LocalizedString" }, "description": "翻译资产库" }
      },
      {
        "path": "/settings/ai",
        "definition": { "schema": { "type": "object" }, "description": "AI 智译配置" }
      },
      {
        "path": "/galleryAssets/{assetId}",
        "definition": { "schema": { "type": "object" }, "description": "云端媒体资产" }
      }
    ]
  }
}